{
  "manifestVersion": 5,
  "id": "com.motionstudio.premiere",
  "name": "Motion Studio",
  "version": "1.0.0",
  "main": "index.html",
  "host": [
    {
      "app": "premierepro",
      "minVersion": "24.0.0"
    },
    {
      "app": "aftereffects",
      "minVersion": "24.0.0"
    }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "motionStudioPanel",
      "label": {
        "default": "Motion Studio Graph Editor"
      },
      "minimumSize": {
        "width": 380,
        "height": 400
      },
      "maximumSize": {
        "width": 2560,
        "height": 1440
      },
      "preferredDockedSize": {
        "width": 520,
        "height": 650
      }
    }
  ],
  "icons": [
    {
      "width": 23,
      "height": 23,
      "path": "icons/icon-23.png"
    }
  ],
  "featureFlags": {
    "enableSWCSupport": true
  },
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "network": {
      "domains": "all"
    },
    "clipboard": "readAndWrite",
    "allowCodeGenerationFromStrings": true
  }
}
